generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id              Int              @id @default(autoincrement())
  name            String
  subject         String?
  body            String?
  status          String           @default("DRAFT")
  sent_count      Int              @default(0)
  delivered_count Int              @default(0)
  failed_count    Int              @default(0)
  opens_count     Int              @default(0)
  unread_count    Int              @default(0)
  bounce_count    Int              @default(0)
  scheduled_for   String?
  created_at      DateTime         @default(now())
  emails          Email[]

  @@map("campaigns")
}

model Email {
  id              Int              @id @default(autoincrement())
  campaign_id     Int?
  recipient_email String
  status          String           @default("PENDING")
  subject         String?
  body            String?
  failure_reason  String?
  bounce_reason   String?
  bounce_type     String?
  delivery_status String?
  sent_at         DateTime         @default(now())
  opened_at       DateTime?
  clicked_at      DateTime?
  campaign        Campaign?        @relation(fields: [campaign_id], references: [id])
  events          EmailEvent[]

  @@index([campaign_id])
  @@index([recipient_email])
  @@index([sent_at])
  @@map("emails")
}

model EmailEvent {
  id         Int       @id @default(autoincrement())
  email_id   Int
  event_type String
  ip_address String?
  user_agent String?
  browser    String?
  os         String?
  device     String?
  country    String?
  city       String?
  url        String?
  timestamp  DateTime  @default(now())
  email      Email     @relation(fields: [email_id], references: [id])

  @@index([email_id])
  @@index([event_type])
  @@index([timestamp])
  @@map("email_events")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("tags")
}

model Segment {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  criteria    String   @default("{}")
  created_at  DateTime @default(now())

  @@map("segments")
}

model Suppression {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  reason       String
  metadata_raw String?
  created_at   DateTime @default(now())

  @@map("suppressions")
}

model Contact {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  company           String?
  industry          String?
  score             Int      @default(0)
  status            String   @default("active")
  tags_raw          String   @default("")
  total_opens       Int      @default(0)
  total_clicks      Int      @default(0)
  engagement_score  Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  @@map("contacts")
}

model Settings {
  id               Int     @id @default(autoincrement())
  smtp_host        String  @default("smtp.mailflow.com")
  smtp_port        Int     @default(587)
  smtp_username    String  @default("admin@mailflow.com")
  smtp_password    String  @default("")
  sendgrid_api_key String?
  email_provider   String  @default("SMTP")
  from_email       String  @default("noreply@mailflow.com")
  base_url         String  @default("http://localhost:8000")
  webhook_url      String?
  monthly_limit    Int     @default(500000)

  @@map("settings")
}

model Template {
  id         Int      @id @default(autoincrement())
  name       String   @default("Untitled Template")
  content    String   @default("[]")
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("templates")
}

model Automation {
  id             Int              @id @default(autoincrement())
  name           String           @default("Untitled Automation")
  status         String           @default("draft")
  trigger_type   String           @default("WELCOME")
  trigger_config String           @default("{}")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @default(now())
  steps          AutomationStep[]

  @@map("automations")
}

model AutomationStep {
  id            Int        @id @default(autoincrement())
  automation_id Int
  type          String
  config        String     @default("{}")
  position      Int        @default(0)
  automation    Automation @relation(fields: [automation_id], references: [id])

  @@index([automation_id])
  @@map("automation_steps")
}
